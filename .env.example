# Endereço HTTP do servidor
HTTP_HOST=127.0.0.1
HTTP_PORT=3001

# Conexão MySQL. Sem DB_DATABASE, a API sobe mas os endpoints que dependem de
# persistência retornam erro de configuração (503).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE={{crate_name}}
DB_USERNAME=root
DB_PASSWORD=root

# Ambiente. Com production, o JWT_SECRET passa a ser obrigatório.
APP_ENV=local

# Origens permitidas no CORS, separadas por vírgula. Vazio libera qualquer origem.
CORS_ORIGINS=

# Segredo de assinatura dos tokens JWT. Em production, use ao menos 32 caracteres.
JWT_SECRET=development-only-secret

# Rodar migrations no boot (default: true). Use 0/false para desligar.
RUN_MIGRATIONS=true
